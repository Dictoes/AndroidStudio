<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.vaultbyte">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="VaultByte"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VaultByte">
        <activity
            android:name=".ProfileScreenActivity"
            android:exported="false"
            android:theme="@style/Theme.VaultByte" />
        <activity
            android:name=".DashboardScreenActivity"
            android:exported="false" /> <!-- REGISTER SCREEN (FIRST SCREEN) -->
        <activity
            android:name=".RegisterScreenActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- LOGIN SCREEN -->
        <activity
            android:name=".LoginScreenActivity"
            android:exported="false" />
    </application>

</manifest>